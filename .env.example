# Database (PostgreSQL)
DATABASE_URL=postgresql://user:pass@localhost:5432/redacted_compliance

# Better-Auth
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5173

# Ozone signing (Ed25519 32-byte seed as hex, or a PKCS#8 PEM). Never commit real keys.
# Signs /api/v1/screen answers and certificates:
OZONE_API_SIGNING_KEY=
# Public key(s) of the worker's snapshot key, published at /api/v1/keys (ed25519:<base64>, comma separated):
OZONE_SNAPSHOT_PUBLIC_KEYS=
# Only for deployments without the worker: run list sync + snapshot in the app's cron
OZONE_SYNC_IN_APP=
OZONE_SNAPSHOT_SIGNING_KEY=

# (legacy, unused) Chainalysis Free Sanctions API — the on-chain oracle needs no key
CHAINALYSIS_API_KEY=

# Vercel Cron Secret (protects /api/sync from unauthorized calls)
CRON_SECRET=

# THORChain Midgard endpoint
MIDGARD_URL=https://gateway.liquify.com/chain/thorchain_midgard

# Optional list sources that need a (free) account key; unset = not scheduled.
# Chainabuse moderator-verified scam reports (https://chainabuse.readme.io). Review
# Chainabuse's terms before enabling. Free tier: 10 calls/month → weekly, 2 pages.
CHAINABUSE_API_KEY=
CHAINABUSE_MAX_PAGES=
CHAINABUSE_INTERVAL_HOURS=

# (legacy, unused since 2.0: freeze events come from public RPC / explorers without keys)
# Etherscan V2 API key
ETHERSCAN_API_KEY=

# (legacy, unused) Alchemy ETH mainnet
ALCHEMY_API_KEY=
